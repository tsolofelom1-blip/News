<header>
<div class="logo">Google <span>News</span> Live</div>
<div class="search">🔍 <input id="q" placeholder="Search worldwide news..." onkeyup="if(event.key==='Enter') doSearch()"></div>
<select id="country" onchange="changeCountry()">
<option value="US:en">Worldwide (US)</option>
<option value="GB:en">UK</option>
<option value="ZA:en" selected>South Africa</option>
<option value="IN:en">India</option>
<option value="NG:en">Nigeria</option>
<option value="KE:en">Kenya</option>
<option value="ZA:en">Mzansi</option>
<option value="AU:en">Australia</option>
<option value="CA:en">Canada</option>
</select>
<div id="time" style="font-size:12px;color:#5f6368">Live</div>
</header>

<div class="nav" id="nav">
<button class="active" onclick="setCat('top news',this)">Top Stories</button>
<button onclick="setCat('world',this)">World</button>
<button onclick="setCat('business',this)">Business</button>
<button onclick="setCat('technology',this)">Technology</button>
<button onclick="setCat('sports',this)">Sports</button>
<button onclick="setCat('science',this)">Science</button>
<button onclick="setCat('health',this)">Health</button>
<button onclick="setCat('entertainment',this)">Entertainment</button>
<button onclick="setCat('africa',this)">Africa</button>
</div>

<div class="container">
<div class="feed" id="feed">
<div class="live">🔴 LIVE • Auto-updating every 3 minutes • Worldwide</div>
<div style="background:#fff;padding:20px;border-radius:16px;text-align:center">Loading worldwide news...</div>
</div>
</div>

