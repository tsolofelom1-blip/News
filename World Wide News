<title>World News - Auto Updating Google News</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial, sans-serif}
body{background:#f8f9fa}
header{background:#fff;padding:14px 20px;display:flex;align-items:center;gap:16px;border-bottom:1px solid #dadce0;position:sticky;top:0;z-index:99}
.logo{font-weight:700;font-size:22px;color:#202124} .logo span{color:#4285f4}
.search{flex:1;max-width:650px;background:#eef1f3;border-radius:24px;padding:10px 16px;display:flex;gap:8px}
.search input{width:100%;border:none;background:transparent;outline:none;font-size:15px}
.nav{background:#fff;padding:10px 20px;display:flex;gap:8px;overflow-x:auto;border-bottom:1px solid #dadce0;position:sticky;top:58px;z-index:98}
